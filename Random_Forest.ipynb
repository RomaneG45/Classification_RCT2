    "all_X_non_dom_all_list  = np.array(all_X_non_dom_list)\n",
    "all_Y_dom_all_list = np.array(all_Y_dom_all_list)\n",
    "all_X_non_dom_all_list  = np.array(all_X_non_dom_all_list)\n",
    "\"\"\"\n",
    "\n",
