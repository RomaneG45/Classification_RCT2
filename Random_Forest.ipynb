    "all_X_non_dom_list = list(chain.from_iterable(all_X_non_dom))\n",
    "all_Y_dom_all_list = list(chain.from_iterable(all_Y_dom_all))\n",
    "all_Y_non_dom_all_list = list(chain.from_iterable(all_Y_non_dom_all))\n",
    "\n",
